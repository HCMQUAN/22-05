import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.neural_network import MLPClassifier
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
df = pd.read_excel('stress_level_classification_dataset.xlsx')
print("First 5 rows:")
print(df.head())
def classify_stress(row):

    if (
        row['hours of sleep/day'] < 5
        or row['hours of work/day'] > 11
        or row['cups of coffee/day'] > 6
    ):
        return "Malnutrition"
    elif (
        row['hours of sleep/day'] >= 7
        and row['hours of work/day'] <= 8
        and row['cups of coffee/day'] <= 2
    ):
        return "Great"
    else:
        return "Normal"
df['Stress_Level'] = df.apply(classify_stress, axis=1)
print("\nClass Distribution:")
print(df['Stress_Level'].value_counts())
name_encoder = LabelEncoder()
df['name_encoded'] = name_encoder.fit_transform(df['name'])
X = df[[
    'name_encoded',
    'age',
    'hours of work/day',
    'hours of sleep/day',
    'cups of coffee/day'
]]
y = df['Stress_Level']
label_encoder = LabelEncoder()
y_encoded = label_encoder.fit_transform(y)
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
X_train, X_test, y_train, y_test = train_test_split(
    X_scaled,
    y_encoded,
    test_size=0.2,
    random_state=42
)
model = MLPClassifier(
    hidden_layer_sizes=(10, 5),
    activation='relu',
    solver='adam',
    max_iter=2000,
    random_state=42
)
model.fit(X_train, y_train)
y_pred = model.predict(X_test)
accuracy = accuracy_score(y_test, y_pred)
print("\nAccuracy:")
print(accuracy)
print("\nClassification Report:")
print(classification_report(
    y_test,
    y_pred,
    target_names=label_encoder.classes_
))
print("\nConfusion Matrix:")
print(confusion_matrix(y_test, y_pred))
print("\n===================================")
print(" STRESS LEVEL PREDICTION SYSTEM ")
print("===================================\n")
user_name = input("Enter Name: ")
user_age = int(input("Enter Age: "))
user_work = float(input("Enter Hours of Work per Day: "))
user_sleep = float(input("Enter Hours of Sleep per Day: "))
user_coffee = int(input("Enter Cups of Coffee per Day: "))
if user_name in name_encoder.classes_:
    user_name_encoded = name_encoder.transform([user_name])[0]
else:
    user_name_encoded = 0
custom_data = np.array([[
    user_name_encoded,
    user_age,
    user_work,
    user_sleep,
    user_coffee
]])
custom_data_scaled = scaler.transform(custom_data)
prediction = model.predict(custom_data_scaled)
predicted_label = label_encoder.inverse_transform(prediction)
print("\n===================================")
print(" Prediction Result ")
print("===================================")
print(f"Name               : {user_name}")
print(f"Age                : {user_age}")
print(f"Hours of Work/Day  : {user_work}")
print(f"Hours of Sleep/Day : {user_sleep}")
print(f"Cups of Coffee/Day : {user_coffee}")
print("\nPredicted Stress Level:")
print(">>>", predicted_label[0])
